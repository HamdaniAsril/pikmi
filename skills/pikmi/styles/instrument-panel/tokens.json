{
  "name": "instrument-panel",
  "title": "Instrument Panel",
  "fonts": {
    "sans": {
      "family": "Noto Sans JP",
      "weights": [200, 300, 400, 500]
    },
    "dot": {
      "family": "Doto",
      "weights": [700, 900]
    }
  },
  "typeScale": { "label": 11, "caption": 12, "body": 15, "lead": 18, "h3": 22, "h2": 32, "h1": 48, "display": 88 },
  "tracking": { "label": 1.5 },
  "radius": { "key": 4, "control": 6, "panel": 12, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 24, "xl": 48 },
  "colors": {
    "signal-blue": "#0071BB",
    "signal-green": "#006837",
    "signal-yellow": "#FAB413",
    "led": "#2BD46B",
    "screen-bezel": "#1C1B20",
    "encoder-ring": "#D4D4D4",
    "encoder-groove": "#BFBFBF",
    "encoder-cap-shade": "#00000033"
  },
  "effects": { "key-travel": "0 2px 0" },
  "themes": {
    "light": {
      "page": "#F0F0EF",
      "panel": "#E5E5E5",
      "card": "#F5F5F5",
      "rule": "#CCCCCC",
      "text": "#0F0E12",
      "text-muted": "#4D4D4D",
      "accent": "#F05A24",
      "on-accent": "#0F0E12",
      "danger": "#B81D13",
      "link": "#0071BB",
      "key": "#F5F5F5",
      "key-label": "#4D4D4D",
      "key-number": "#0F0E12",
      "key-shadow": "#B2B2B2",
      "key-alt": "#0F0E12",
      "key-alt-label": "#B2B2B2",
      "key-alt-number": "#F5F5F5",
      "key-alt-shadow": "#000000",
      "key-active": "#F05A24",
      "key-active-ink": "#0F0E12",
      "key-active-shadow": "#9C3612",
      "screen": "#0F0E12",
      "on-screen": "#F5F5F5"
    },
    "dark": {
      "page": "#0F0E12",
      "panel": "#272727",
      "card": "#272727",
      "rule": "#4D4D4D",
      "text": "#F5F5F5",
      "text-muted": "#B2B2B2",
      "accent": "#F05A24",
      "on-accent": "#0F0E12",
      "danger": "#FF7A6B",
      "link": "#F5F5F5",
      "key": "#3B3B3D",
      "key-label": "#B2B2B2",
      "key-number": "#F5F5F5",
      "key-shadow": "#000000",
      "key-alt": "#0F0E12",
      "key-alt-label": "#B2B2B2",
      "key-alt-number": "#F5F5F5",
      "key-alt-shadow": "#000000",
      "key-active": "#F05A24",
      "key-active-ink": "#0F0E12",
      "key-active-shadow": "#9C3612",
      "screen": "#0F0E12",
      "on-screen": "#F5F5F5"
    }
  }
}
