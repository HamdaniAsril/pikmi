{
  "name": "dark-dev",
  "title": "Dark Dev",
  "fonts": {
    "display": {
      "family": "Red Hat Display",
      "weights": [600]
    },
    "body": {
      "family": "Red Hat Text",
      "weights": [400, 500, 600]
    },
    "mono": {
      "family": "Red Hat Mono",
      "weights": [400, 500]
    }
  },
  "typeScale": { "label": 12, "caption": 13, "body": 15, "lead": 17, "h3": 20, "h2": 28, "h1": 44, "display": 64 },
  "radius": { "control": 8, "card": 12 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 24, "xl": 48 },
  "colors": { "body-text": "#CBD5E1", "rule-hover": "#64748B", "success": "#22C55E" },
  "effects": {
    "inset-glow": "inset 0 1px 0 rgba(255, 255, 255, 0.15)",
    "card-shadow": "0 8px 30px rgba(0, 0, 0, 0.5)"
  },
  "themes": {
    "dark": {
      "page": "#0F172A",
      "panel": "#1E293B",
      "card": "#1E293B",
      "rule": "#334155",
      "text": "#F1F5F9",
      "text-muted": "#94A3B8",
      "accent": "#2563EB",
      "on-accent": "#FFFFFF",
      "link": "#60A5FA",
      "danger": "#F87171"
    }
  }
}
