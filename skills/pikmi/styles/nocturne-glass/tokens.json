{
  "name": "nocturne-glass",
  "title": "Nocturne Glass",
  "fonts": {
    "display": {
      "family": "Bodoni Moda",
      "weights": [500]
    },
    "body": {
      "family": "Albert Sans",
      "weights": [400, 500]
    }
  },
  "typeScale": { "label": 12, "caption": 13, "body": 16, "lead": 19, "h3": 24, "h2": 36, "h1": 56, "display": 88 },
  "tracking": { "label": 2 },
  "radius": { "control": 16, "card": 24 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 28, "xl": 56 },
  "colors": {
    "night-deep": "#060A13",
    "moon-steel": "#33517A",
    "moonlight": "#7C9CC4",
    "champagne-bright": "#F3DCA8"
  },
  "effects": {
    "glass-fill": "rgba(255, 255, 255, 0.08)",
    "glass-border": "rgba(255, 255, 255, 0.15)",
    "glass-blur": "40px",
    "glass-shadow": "0 16px 40px rgba(3, 7, 18, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 -1px 0 rgba(2, 6, 16, 0.35)",
    "ease-glass": "cubic-bezier(0.16, 1, 0.3, 1)",
    "grain-opacity": "0.025"
  },
  "themes": {
    "dark": {
      "page": "#0B1322",
      "panel": "#16233A",
      "card": "#16233A",
      "rule": "#303643",
      "text": "#FFFFFF",
      "text-muted": "#A3ABB8",
      "accent": "#E4B863",
      "on-accent": "#0B1322",
      "link": "#F3DCA8",
      "danger": "#F28B82"
    }
  }
}
