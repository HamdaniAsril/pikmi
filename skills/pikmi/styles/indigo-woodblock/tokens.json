{
  "name": "indigo-woodblock",
  "title": "Indigo Woodblock",
  "fonts": {
    "display": {
      "family": "Shippori Mincho B1",
      "weights": [700, 800]
    },
    "body": {
      "family": "Zen Kaku Gothic New",
      "weights": [400, 500]
    }
  },
  "typeScale": { "label": 13, "caption": 14, "body": 17, "lead": 20, "h3": 24, "h2": 36, "h1": 56, "display": 84 },
  "tracking": { "label": 2 },
  "radius": { "key": 2, "card": 2 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 28, "xl": 56 },
  "colors": { "vermilion": "#D4553A", "indigo": "#1A3055", "gold-leaf": "#C9A227" },
  "effects": {
    "print-shadow": "4px 4px 0 #1A3055",
    "print-shadow-hover": "6px 6px 0 #1A3055",
    "outline": "2px solid #1A3055"
  },
  "themes": {
    "light": {
      "page": "#F5F0E1",
      "panel": "#EDE5CF",
      "card": "#FBF8EE",
      "rule": "#1A3055",
      "text": "#1A3055",
      "text-muted": "#3E4F6E",
      "accent": "#B8402A",
      "on-accent": "#F5F0E1",
      "link": "#1A3055",
      "danger": "#9E2A1E"
    }
  }
}
