{
  "name": "anti-design",
  "title": "Anti-Design",
  "fonts": {
    "display": {
      "family": "Archivo Black",
      "weights": [400]
    },
    "body": {
      "family": "Archivo",
      "weights": [400, 700, 900]
    }
  },
  "typeScale": { "label": 13, "caption": 14, "body": 17, "lead": 22, "h3": 28, "h2": 44, "h1": 72, "display": 128 },
  "radius": { "key": 0, "panel": 0 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 32, "xl": 64 },
  "colors": {
    "clash-blue": "#0000FF",
    "clash-yellow": "#FFFF00",
    "clash-magenta": "#FF00FF",
    "clash-cyan": "#00FFFF",
    "clash-green": "#00FF00"
  },
  "effects": {
    "hard-shadow": "8px 8px 0 #000000",
    "hard-shadow-sm": "4px 4px 0 #000000",
    "border-heavy": "6px solid #000000",
    "border-focus": "8px solid #0000FF"
  },
  "themes": {
    "light": {
      "page": "#FFFFFF",
      "panel": "#FFFF00",
      "card": "#FFFFFF",
      "rule": "#000000",
      "text": "#000000",
      "text-muted": "#000000",
      "accent": "#FF0000",
      "on-accent": "#000000",
      "link": "#0000FF",
      "danger": "#CC0000"
    }
  }
}
