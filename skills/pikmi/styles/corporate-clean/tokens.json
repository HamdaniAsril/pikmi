{
  "name": "corporate-clean",
  "title": "Corporate Clean",
  "fonts": {
    "body": {
      "family": "IBM Plex Sans",
      "weights": [400, 500, 600]
    }
  },
  "typeScale": { "label": 12, "caption": 13, "body": 16, "lead": 18, "h3": 20, "h2": 28, "h1": 40, "display": 56 },
  "tracking": { "label": 0.5 },
  "radius": { "control": 8, "card": 12 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 48 },
  "colors": { "ink": "#0F2A5C", "success": "#15803D", "warning": "#B45309", "focus": "#3B82F6" },
  "effects": {
    "shadow-rest": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "shadow-raised": "0 4px 12px rgba(15, 23, 42, 0.08)"
  },
  "themes": {
    "light": {
      "page": "#F8FAFC",
      "panel": "#FFFFFF",
      "card": "#FFFFFF",
      "rule": "#E5E7EB",
      "text": "#111827",
      "text-muted": "#4B5563",
      "accent": "#1F4FD1",
      "on-accent": "#FFFFFF",
      "link": "#1D4ED8",
      "danger": "#DC2626"
    }
  }
}
