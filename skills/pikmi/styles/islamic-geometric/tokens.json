{
  "name": "islamic-geometric",
  "title": "Islamic Geometric",
  "fonts": {
    "display": {
      "family": "El Messiri",
      "weights": [600, 700]
    },
    "body": {
      "family": "Noto Sans",
      "weights": [400, 500]
    }
  },
  "typeScale": { "label": 13, "caption": 14, "body": 17, "lead": 20, "h3": 24, "h2": 34, "h1": 52, "display": 72 },
  "tracking": { "label": 1.5, "heading": 0.5 },
  "radius": { "control": 8, "card": 12 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 28, "xl": 56 },
  "colors": { "gold": "#C9A74E", "emerald": "#25693B", "deep-red": "#8B2332" },
  "effects": {
    "gold-rule": "linear-gradient(90deg, transparent, #C9A74E, transparent)",
    "arch-radius": "50% 50% 12px 12px / 30% 30% 12px 12px"
  },
  "themes": {
    "light": {
      "page": "#F5ECD7",
      "panel": "#FBF6EA",
      "card": "#FFFDF7",
      "rule": "#C9A74E",
      "text": "#1A3A5C",
      "text-muted": "#4A5B70",
      "accent": "#1A3A5C",
      "on-accent": "#F5ECD7",
      "link": "#1A3A5C",
      "danger": "#8B2332"
    },
    "dark": {
      "page": "#122A44",
      "panel": "#1A3A5C",
      "card": "#1F4468",
      "rule": "#C9A74E",
      "text": "#F5ECD7",
      "text-muted": "#C9BFA8",
      "accent": "#C9A74E",
      "on-accent": "#122A44",
      "link": "#E6CF8A",
      "danger": "#F09AA3"
    }
  }
}
