{
  "name": "cyberpunk-neon",
  "title": "Cyberpunk Neon",
  "fonts": {
    "display": {
      "family": "Chakra Petch",
      "weights": [400, 600, 700]
    },
    "mono": {
      "family": "Share Tech Mono",
      "weights": [400]
    }
  },
  "typeScale": { "label": 12, "caption": 13, "body": 16, "lead": 18, "h3": 24, "h2": 36, "h1": 56, "display": 96 },
  "tracking": { "label": 2, "display": 1 },
  "radius": { "key": 2, "panel": 4 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 24, "xl": 48 },
  "colors": { "neon-magenta": "#FF2BD6", "neon-yellow": "#FACC15" },
  "effects": {
    "glow": "0 0 20px rgba(0, 240, 255, 0.5)",
    "scanline": "repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 3px)"
  },
  "themes": {
    "dark": {
      "page": "#0A0A0F",
      "panel": "#111118",
      "card": "#16161F",
      "rule": "#075457",
      "text": "#F2F7FA",
      "text-muted": "#9CA3AF",
      "accent": "#00F0FF",
      "on-accent": "#0A0A0F",
      "link": "#00F0FF",
      "danger": "#FF5C8A"
    }
  }
}
