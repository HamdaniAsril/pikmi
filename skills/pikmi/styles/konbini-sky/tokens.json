{
  "name": "konbini-sky",
  "title": "Konbini Sky",
  "fonts": {
    "sans": {
      "family": "Public Sans",
      "weights": [500, 700, 900]
    },
    "jp": {
      "family": "Noto Sans JP",
      "weights": [900]
    }
  },
  "typeScale": { "label": 13, "caption": 14, "body": 17, "lead": 20, "h3": 24, "h2": 34, "h1": 56, "display": 320 },
  "radius": { "control": 0, "card": 0 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 48, "section": 96 },
  "colors": { "on-sky": "#FFFFFF" },
  "effects": {
    "sky": "linear-gradient(180deg, var(--sky-top) 0%, var(--sky-top) 28%, var(--sky-mid) 68%, var(--horizon) 100%)",
    "tracking-display": "-0.05em",
    "leading-display": "0.82",
    "rule-strong": "2px solid var(--ink)"
  },
  "themes": {
    "light": {
      "page": "#F7F7F4",
      "panel": "#FFFFFF",
      "card": "#FFFFFF",
      "rule": "rgba(29, 91, 216, 0.28)",
      "text": "#1E2B4A",
      "text-muted": "#4A5876",
      "accent": "#1D5BD8",
      "on-accent": "#FFFFFF",
      "link": "#1D5BD8",
      "danger": "#C0352B",
      "ink": "#1D5BD8",
      "sky-top": "#5CB9E8",
      "sky-mid": "#96D3F0",
      "horizon": "#E3F2FA",
      "orange": "#EE6A2B",
      "focus-on-sky": "#1E2B4A"
    }
  }
}
