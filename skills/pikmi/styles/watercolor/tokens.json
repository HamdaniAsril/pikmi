{
  "name": "watercolor",
  "title": "Watercolor",
  "fonts": {
    "display": {
      "family": "Cormorant",
      "weights": [500, 600]
    },
    "body": {
      "family": "Crimson Pro",
      "weights": [400, 500]
    }
  },
  "typeScale": { "label": 14, "caption": 15, "body": 19, "lead": 22, "h3": 28, "h2": 40, "h1": 60, "display": 88 },
  "radius": { "control": 16, "card": 28 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 32, "xl": 64 },
  "colors": { "peach": "#E8A87C", "teal": "#85CDCA", "rose": "#C38D94", "sand": "#D4A373" },
  "effects": { "bloom-shadow": "0 10px 40px rgba(74, 111, 165, 0.25)", "wash-opacity": "0.3" },
  "themes": {
    "light": {
      "page": "#FAF8F5",
      "panel": "#F3EEE7",
      "card": "#FFFFFF",
      "rule": "#E2D8CC",
      "text": "#3D5F91",
      "text-muted": "#586A89",
      "accent": "#4A6FA5",
      "on-accent": "#FFFFFF",
      "link": "#3D5F91",
      "danger": "#A6464F"
    }
  }
}
