{
  "name": "japanese-minimal",
  "title": "Japanese Minimal",
  "fonts": {
    "body": {
      "family": "M PLUS 1",
      "weights": [200, 300, 400]
    }
  },
  "typeScale": { "label": 13, "caption": 14, "body": 17, "lead": 20, "h3": 22, "h2": 30, "h1": 44, "display": 64 },
  "tracking": { "label": 1, "heading": 0.5 },
  "radius": { "control": 6, "card": 8 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 32, "xl": 64, "section": 128 },
  "colors": { "mint": "#98D8C8", "sakura": "#FFB7C5", "powder": "#B8D4E3" },
  "effects": { "hairline": "1px solid #D4D4CF" },
  "themes": {
    "light": {
      "page": "#FAFAF8",
      "panel": "#F4F4F1",
      "card": "#FFFFFF",
      "rule": "#D4D4CF",
      "text": "#4A5568",
      "text-muted": "#5F6E82",
      "accent": "#64B5F6",
      "on-accent": "#1F2A37",
      "link": "#2F6FA8",
      "danger": "#B5485A"
    }
  }
}
