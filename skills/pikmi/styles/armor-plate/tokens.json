{
  "name": "armor-plate",
  "title": "Armor Plate",
  "fonts": {
    "display": {
      "family": "Saira Condensed",
      "weights": [600, 700]
    },
    "body": {
      "family": "Saira",
      "weights": [400, 500]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [400, 500]
    }
  },
  "typeScale": { "label": 12, "caption": 13, "body": 16, "lead": 18, "h3": 24, "h2": 36, "h1": 60, "display": 104 },
  "tracking": { "label": 2.5, "display": 1 },
  "radius": { "none": 0 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 24, "xl": 48 },
  "colors": { "armor-green": "#4A5C3A", "hazard-yellow": "#FBBF24", "hazard-red": "#EF4444" },
  "effects": {
    "plate-shadow": "4px 4px 0 #0B1120",
    "hazard-stripes": "repeating-linear-gradient(-45deg, #FBBF24 0 10px, #141E33 10px 20px)",
    "plate-cut": "polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px))",
    "tech-grid": "linear-gradient(rgba(169, 179, 196, 0.08) 1px, transparent 1px) 0 0 / 24px 24px, linear-gradient(90deg, rgba(169, 179, 196, 0.08) 1px, transparent 1px) 0 0 / 24px 24px"
  },
  "themes": {
    "dark": {
      "page": "#141E33",
      "panel": "#1A2744",
      "card": "#1F2D4D",
      "rule": "#4A5C3A",
      "text": "#E6E9EF",
      "text-muted": "#A9B3C4",
      "accent": "#FBBF24",
      "on-accent": "#141E33",
      "link": "#FBBF24",
      "danger": "#F87171"
    }
  }
}
