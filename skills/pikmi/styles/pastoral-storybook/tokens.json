{
  "name": "pastoral-storybook",
  "title": "Pastoral Storybook",
  "fonts": {
    "display": {
      "family": "Kaisei Decol",
      "weights": [500, 700]
    },
    "body": {
      "family": "Zen Maru Gothic",
      "weights": [400, 500, 700]
    }
  },
  "typeScale": { "label": 13, "caption": 14, "body": 17, "lead": 20, "h3": 24, "h2": 34, "h1": 52, "display": 76 },
  "radius": { "pill": 999, "card": 24, "panel": 32 },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 28, "xl": 56 },
  "colors": { "sky": "#85CDCA", "coral": "#E8A87C", "rose": "#C38D94", "bark": "#2F2A22" },
  "effects": { "soft-shadow": "0 8px 30px rgba(90, 74, 58, 0.10)" },
  "themes": {
    "light": {
      "page": "#F4E4BC",
      "panel": "#FBF3DE",
      "card": "#FFFAEF",
      "rule": "#E3CFA0",
      "text": "#5A4A3A",
      "text-muted": "#6B5844",
      "accent": "#7CB9A8",
      "on-accent": "#2F2A22",
      "link": "#33695A",
      "danger": "#A8473F"
    }
  }
}
